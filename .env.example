# Local development configuration for the collector.
# Copy to .env and adjust. Never commit real tokens.
ATRIUM_COLLECTOR_PORT=8787
ATRIUM_SOURCE=fake
# Ananta hub (Flask) — see docs/integration-ananta.md
ATRIUM_HUB_URL=http://127.0.0.1:5000
ATRIUM_HUB_TOKEN=
# llama.cpp runtimes, comma separated. Ports come from the Ananta stack,
# they are not assumed to be 8080.
ATRIUM_LLAMA_URLS=http://127.0.0.1:18150
# Broadcast snapshot rate in Hz.
ATRIUM_STATE_HZ=8
