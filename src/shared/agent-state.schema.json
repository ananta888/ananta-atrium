{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ananta-atrium.local/schemas/agent-state.v1.json",
  "title": "AgentState v1",
  "description": "Normalized state for one agent shown in the atrium. Additional optional fields must be preserved by consumers.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "role",
    "status",
    "buildingId",
    "roomId",
    "deskId",
    "task",
    "activity",
    "updatedAt",
    "source",
    "stale"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "role": { "type": "string", "maxLength": 64 },
    "status": {
      "enum": ["idle", "working", "waiting", "reviewing", "offline"]
    },
    "buildingId": { "type": "string", "minLength": 1 },
    "roomId": { "type": "string", "minLength": 1 },
    "deskId": { "type": "string", "minLength": 1 },
    "task": {
      "type": "object",
      "required": ["title", "progress"],
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "taskId": { "type": "string" }
      },
      "additionalProperties": true
    },
    "activity": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["typing", "reading", "thinking", "meeting", "walking", "reviewing", "idle"]
        },
        "detail": { "type": "string", "maxLength": 200 }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "properties": {
        "tokensPerSecond": { "type": "number", "minimum": 0 },
        "contextUsed": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "source": { "enum": ["live", "fake"] },
    "stale": { "type": "boolean" },
    "position": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
